{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts",
    "electron.vite.config.ts",
    "src/lib/bitmapPixelSize.ts",
    "src/lib/cardSpot.ts",
    "src/lib/documentScope.ts",
    "src/lib/export.ts",
    "src/lib/findScan.ts",
    "src/lib/flash.ts",
    "src/lib/lazyPages.ts",
    "src/lib/latestSearch.ts",
    "src/lib/offline.ts",
    "src/lib/pageBudgetCommit.ts",
    "src/lib/pageWalk.ts",
    "src/lib/refly.ts",
    "src/lib/timing.ts"
  ]
}
