    "src/lib/annotationNote.ts",
    "src/lib/batch.ts",
    "src/lib/batchGate.ts",
    "src/lib/bitmapPixelSize.ts",
    "src/lib/cardSpot.ts",
    "src/lib/cite.ts",
    "src/lib/citeKey.ts",
    "src/lib/columns.ts",
    "src/lib/continuousScroll.ts",
    "src/lib/documentScope.ts",
    "src/lib/dupes.ts",
    "src/lib/export.ts",
    "src/lib/exportTypes.ts",
    "src/lib/filters.ts",
    "src/lib/findScan.ts",
    "src/lib/flash.ts",
    "src/lib/folderForDoc.ts",
    "src/lib/importText.ts",
    "src/lib/lazyPages.ts",
    "src/lib/latestSearch.ts",
    "src/lib/listBlank.ts",
    "src/lib/match.ts",
    "src/lib/offline.ts",
    "src/lib/overlayStack.ts",
    "src/lib/pageBudgetCommit.ts",
