    "src/lib/panes.ts",
    "src/lib/pdfcache.ts",
    "src/lib/pdfgeom.ts",
    "src/lib/rectLines.ts",
    "src/lib/savedSearch.ts",
    "src/lib/refly.ts",
    "src/lib/splitPersonName.ts",
    "src/lib/timing.ts",
    "src/lib/tree.ts",
    "src/lib/view.ts",
    "src/lib/viewGeneration.ts"
  ]
