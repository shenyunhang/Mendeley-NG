{
  "name": "mendeley-ng",
  "version": "0.1.25",
  "description": "A high-DPI-native replacement for Mendeley Desktop 1.19.8",
  "main": "out/main/index.js",
  "author": "shenyunhang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "node scripts/start.mjs",
    "smoke": "node scripts/start.mjs --smoke",
    "demo": "node scripts/demo.mjs",
    "build": "electron-vite build && node scripts/copy-worker.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "signcheck": "node scripts/signcheck.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.shenyunhang.mendeleyng",
    "productName": "Mendeley NG",
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis",
      "artifactName": "Mendeley-NG-${version}-Setup.${ext}",
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "timeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "shenyunhang",
      "repo": "Mendeley-NG"
    }
  }
}
